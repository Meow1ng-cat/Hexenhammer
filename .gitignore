# This is a .gitignore file for Unreal Engine projects.
# Adapted from: https://github.com/github/gitignore/blob/main/UnrealEngine.gitignore

# Include commonly used LFS patterns
*.uasset
*.umap
*.fbx
*.obj
*.wav
*.mp3
*.png
*.jpg
*.jpeg
*.psd
*.tga
*.mov
*.avi
*.mp4

# Visual Studio
.vs/
*.VC.db
*.opendb
*.sln.docstates
*.suo
*.user
*.userosscache
*.sln.ide
*.csproj
*.dotSettings
*.DotSettings.user
*.DotSettings
*.cachefile
*.VC.VC.opendb
*.VC.db
*.pidb
*.suo
*.tmp
*.tmp_proj
*.log
*.tlog
*.lastbuildstate
*.idxsym
*.idb

# Compiled source
bin/
obj/
*.o
*.lo
*.la
*.al
*.so
*.so.*
*.dylib
*.dll
*.lib
*.exe
*.dll
*.so
*.app

# Packages & Intermediate
Intermediate/
Binaries/
DerivedDataCache/
Saved/
Build/
*.sdf
*.opensdf
*.VC.opendb
*.VC.db
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates

# Other common Unreal Engine directories
Content/Intermediate/
Content/AssetRegistryCache/
Intermediate/Config/
Source/Intermediate/

# IntelliSense/Code Completion files
*.sbr
*.bsc
*.pdb
*.ilk
*.pdb
*.exp
*.lib
*.obj
*.idb
*.pdb
*.bsc
*.res

# Backup files
*~
*.bak
*.tmp
*.old
*.orig

# Logs and crash dumps
*.log
*.dmp

# Files generated by Unreal Engine
*.unreal
*.sln
*.xcodeproj
*.xcworkspace
*.kdev4
# Visual Studio solutions in the newer format, generated by UBT like the *.sln above
*.slnx
